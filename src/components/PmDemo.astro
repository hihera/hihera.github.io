  .sl.tot{margin-top:4px;padding-top:8px;border-top:1px solid var(--line);font-size:13px;color:var(--ink);font-weight:600}
  .sl.tot b{font-size:20px;font-weight:800;letter-spacing:-.01em;color:var(--ac)}
