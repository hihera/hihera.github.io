  .kv b{color:#fff;font-weight:600}
  .kv .pos{color:#6EE7B7}
  .checks{list-style:none;margin:2px 0 0;padding:10px 0 0;border-top:1px solid rgba(255,255,255,.1);display:flex;flex-direction:column;gap:6px}
  .checks li{position:relative;padding-left:18px;font-size:11px;color:#D1D5DB;line-height:1.45}
  .checks li:before{content:'';position:absolute;left:0;top:2px;width:12px;height:12px;border-radius:50%;background:#22C55E}
  .checks li:after{content:'';position:absolute;left:4.3px;top:4.3px;width:3px;height:5.5px;border:solid #fff;border-width:0 1.5px 1.5px 0;transform:rotate(45deg)}
  .toast{position:absolute;right:0;bottom:0;display:flex;align-items:center;gap:8px;font-size:12px;font-weight:500;color:#fff;background:var(--ink);border-radius:12px;padding:10px 14px;box-shadow:0 14px 30px rgba(16,24,40,.3);width:200px}

  .cap{margin-top:16px;text-align:center;font-size:var(--fs-meta);color:#A8A8AE;min-height:1.6em;transition:opacity .3s}

  @media (prefers-reduced-motion:reduce){
    [data-at],.slide,.pa,.pb,.pair i,.gv,.fd,.goal,.req,.col,.ly,.kpi,.pill,.toc li,.tbl .tr{transition:none!important}
    .st,.caret{animation:none}
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pmd]');
  if (root) {
    const fit = root.querySelector<HTMLElement>('.fit')!;
    const app = root.querySelector<HTMLElement>('.app')!;
    const cap = root.querySelector<HTMLElement>('.cap')!;
    const caps: string[] = JSON.parse(root.dataset.caps || '[]');
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('.tb'));
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('.scene'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 等比缩放画布
    const resize = () => {
      const s = Math.min(1, fit.clientWidth / 1080);
      app.style.transform = `scale(${s})`;
      fit.style.height = `${640 * s}px`;
    };
    new ResizeObserver(resize).observe(fit);
    resize();

    type Plan = { text: string; typeStart: number; typeEnd: number; events: number[]; total: number };
    const CHAR = 28; // 每个字的打字间隔（毫秒）
    const build = (sc: HTMLElement): Plan => {
      const text = sc.querySelector<HTMLElement>('.typed')!.dataset.text || '';
      const typeStart = 150;
      const typeEnd = typeStart + Array.from(text).length * CHAR;
      const gaps = (sc.dataset.gaps || '').split(',').map(Number);
      const events: number[] = [];
      let at = typeEnd + 250;
      gaps.forEach((g) => { events.push(at); at += g; });
      return { text, typeStart, typeEnd, events, total: at + Number(sc.dataset.hold || 4000) };
    };

    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const t0 = performance.now();
      const run = (now: number) => {
        const p = Math.min(1, (now - t0) / 900);
        const v = Math.round(target * (1 - Math.pow(1 - p, 3)));
        el.textContent = v.toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(run);
      };
      requestAnimationFrame(run);
    };

    let cur = 0;
    let t = 0;
    let plan = build(scenes[0]);
    let lastStep = -1;
    let paused = false;
    let visible = false;

    const apply = (sc: HTMLElement, step: number) => {
      sc.dataset.step = String(step);
      sc.querySelectorAll<HTMLElement>('[data-at]').forEach((el) => {
        const at = Number(el.dataset.at);
        const out = el.dataset.out ? Number(el.dataset.out) : Infinity;
        el.classList.toggle('in', step >= at && step < out);
      });
      sc.querySelectorAll<HTMLElement>('[data-ok]').forEach((el) => el.classList.toggle('ok', step >= Number(el.dataset.ok)));
      sc.classList.toggle('writing', sc === scenes[1] && step >= 5);
      sc.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const holder = el.closest<HTMLElement>('[data-at]');
        const shown = holder ? holder.classList.contains('in') : true;
        if (shown && !el.dataset.done) { el.dataset.done = '1'; reduce ? (el.textContent = Number(el.dataset.count).toLocaleString('en-US')) : countUp(el); }
        if (!shown) { el.dataset.done = ''; el.textContent = '0'; }
      });
    };

    const render = () => {
      const sc = scenes[cur];
      let step = 0;
      plan.events.forEach((e, k) => { if (t >= e) step = k + 1; });
      const typed = sc.querySelector<HTMLElement>('.typed')!;
      const chars = Array.from(plan.text);
      const n = step >= 1 ? 0 : Math.max(0, Math.min(chars.length, Math.floor((t - plan.typeStart) / CHAR)));
      typed.textContent = chars.slice(0, n).join('');
      sc.classList.toggle('typing', step < 1 && n > 0);
      if (step !== lastStep) { apply(sc, step); lastStep = step; }
    };

    const show = (i: number) => {
      cur = i;
      plan = build(scenes[i]);
      t = reduce ? plan.total - 1 : 0;
      lastStep = -1;
      scenes.forEach((s, k) => s.classList.toggle('on', k === i));
      tabs.forEach((b) => b.classList.remove('on'));
      void root.offsetWidth; // 进度条从头开始
      tabs.forEach((b, k) => { b.classList.toggle('on', k === i); b.style.setProperty('--dur', `${plan.total}ms`); });
      cap.textContent = caps[i] || '';
      render();
    };

    tabs.forEach((b, k) => b.addEventListener('click', () => show(k)));
    // 悬停暂停，方便细看
    fit.addEventListener('mouseenter', () => { paused = true; root.classList.add('paused'); });
    fit.addEventListener('mouseleave', () => { paused = false; if (visible) root.classList.remove('paused'); });
    new IntersectionObserver((es) => {
      es.forEach((e) => {
        const was = visible;
        visible = e.isIntersecting;
        root.classList.toggle('paused', !visible || paused);
        if (visible && !was && t === 0) show(cur);
      });
    }, { threshold: 0.35 }).observe(root);

    show(0);
    if (!reduce) {
      window.setInterval(() => {
        if (paused || !visible) return;
        t += 50;
        if (t >= plan.total) { show((cur + 1) % scenes.length); return; }
        render();
      }, 50);
    }
  }
</script>
