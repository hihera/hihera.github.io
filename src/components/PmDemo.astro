  .icard.in .gv{stroke-dashoffset:calc(314 - 314 * var(--m) / 100)}
  .glab{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .glab b{font-size:22px;font-weight:800;letter-spacing:-.02em}
